# ============================================================
#  تطبيق النور الإسلامي — قالب متغيرات البيئة
#  انسخ هذا الملف إلى .env وضع مفاتيحك الخاصة فيه.
#  ⚠️ لا ترفع .env إلى Git أبدًا (مستثنى في .gitignore).
# ============================================================

# --- إعدادات التشغيل ---
# بيئة التشغيل (development / production)
NODE_ENV=development
# منفذ الخادم (الإنتاج يستخدم 8080)
PORT=3000
# عنوان التطبيق العام (يستخدم للـ PWA والروابط الذاتية)
APP_URL=http://localhost:3000

# --- محرك الذكاء الاصطناعي الأساسي ---
# مطلوب لمزايا الـ AI (الرفيق الصوتي، عين البصيرة، الفتاوى)
# احصل عليها من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="PUT_YOUR_GEMINI_API_KEY_HERE"

# --- مزود ذكاء اصطناعي إضافي (اختياري تمامًا) ---
# التطبيق يعمل بـ Gemini فقط بدون أي من هذه القيم.
# إذا أردت توجيه بعض الطلبات لمزود آخر (DeepSeek / Groq / OpenRouter /
# Ollama / أو أي خادم متوافق مع OpenAI)، املأ الثلاثة معًا:
#
#   CUSTOM_AI_BASE_URL  عنوان الـ API بدون شرطة مائلة في الآخر
#   CUSTOM_AI_API_KEY   مفتاح المزود
#   CUSTOM_AI_MODEL     اسم النموذج
#
# أمثلة:
#   CUSTOM_AI_BASE_URL="https://api.deepseek.com/v1"
#   CUSTOM_AI_MODEL="deepseek-chat"
#
#   CUSTOM_AI_BASE_URL="https://api.groq.com/openai/v1"
#   CUSTOM_AI_MODEL="llama-3.3-70b-versatile"
#
#   CUSTOM_AI_BASE_URL="http://localhost:11434/v1"   # Ollama محلي
#   CUSTOM_AI_MODEL="llama3.1"
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL=""
